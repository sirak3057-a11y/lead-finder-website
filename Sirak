    .badge::before{
      content:"";width:8px;height:8px;border-radius:50%;background:var(--mint);
      box-shadow:0 0 14px rgba(25,179,138,.75);
    }

    .sub{
      color:var(--muted);margin-bottom:24px;font-size:15px;line-height:1.7;
    }

    form{
      display:grid;gap:14px;background:var(--card);border:1px solid var(--line);
      border-radius:22px;padding:26px;box-shadow:var(--shadow);
