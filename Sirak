    .acts a,.acts .cp{
      display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;border-radius:10px;
      color:var(--blue);text-decoration:none;font-size:14px;font-weight:700;background:rgba(47,91,255,.08);
      border:1px solid rgba(47,91,255,.08);transition:all .2s ease;
    }
    .acts a:hover,.acts .cp:hover{
      background:rgba(47,91,255,.12);transform:translateY(-1px);
    }
    .acts .cp{
      cursor:pointer;border:none;font-family:inherit;color:var(--blue);
    }

    .hint{
      margin-top:28px;color:var(--muted);font-size:14px;line-height:1.7;padding:14px 16px;
      border-left:3px solid var(--blue);background:rgba(47,91,255,.04);border-radius:10px;
    }

    @media (max-width:620px){
      .hero{display:block}
      .badge{margin-top:12px;display:inline-flex}
      .two{grid-template-columns:1fr}
      .summary{grid-template-columns:1fr}
      h1{font-size:27px}
      body{padding:20px 14px 60px}
      form{padding:18px}
    }
  </style>
</head>
<body>
  <main>
    <div class="hero">
      <h1>Find businesses without a website</h1>
      <div class="badge">Local leads</div>
    </div>

    <p class="sub">Enter a business type and a city. The list shows local businesses that have no website on their Google listing.</p>

    <form id="f">
      <label>Google Places API key
        <input id="key" type="password" autocomplete="off" placeholder="Paste your key (saved only in this browser)" required>
      </label>

      <div class="two">
        <label>Business type
          <input id="type" type="text" placeholder="e.g. barbers, restaurants, plumbers" required>
        </label>
        <label>City
          <input id="city" type="text" placeholder="e.g. Haifa, Tel Aviv, חיפה" required>
        </label>
      </div>

      <div class="site-wrap">
        <label>Your website URL
          <input id="myurl" type="text" inputmode="url" placeholder="https://yourwebsite.com">
        </label>
        <div id="urlPreview" class="url-preview" aria-live="polite">
          <div class="site-pill">
            <span class="site-dot"></span>
            <span id="urlText">Website ready</span>
          </div>
        </div>
      </div>

      <label class="chk">
        <input id="social" type="checkbox" checked>
        Also show businesses that only have a Facebook or Instagram page
      </label>

      <button id="go" type="submit">Find businesses</button>
    </form>

    <div class="summary" aria-live="polite">
      <div class="stat">
        <div class="label">Potential leads</div>
        <div id="leadCount" class="value">0</div>
      </div>
      <div class="stat">
        <div class="label">Checked</div>
        <div id="checkedCount" class="value">0</div>
      </div>
      <div class="stat">
        <div class="label">Status</div>
        <div id="statusCount" class="value">Ready</div>
      </div>
    </div>

    <p id="msg" role="status" aria-live="polite"></p>
    <div id="out" class="list"></div>

    <p class="hint">Results come from Google listings, which are not always complete. Before you contact a business, search for its name to confirm it really has no website.</p>
  </main>

  <script>
    var $ = function(id){ return document.getElementById(id); };
    var SOCIAL = /(facebook\.com|fb\.com|instagram\.com|linktr\.ee|tiktok\.com|wa\.me|linkedin\.com|twitter\.com|x\.com|business\.site)/i;

    try {
      $('key').value = localStorage.getItem('placesKey') || '';
      $('myurl').value = localStorage.getItem('myUrl') || '';
      updateWebsitePreview($('myurl').value);
    } catch (e) {}

    function el(tag, cls, text){
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    }

    function link(text, href){
      var a = el('a', '', text);
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener';
      return a;
    }

    function pitch(name, url){
      return 'Hi, I found ' + name + ' on Google and noticed you don\'t have a website yet. '
        + 'I build modern, fast websites for local businesses, and you can see my work here: '
        + (url || 'https://example.com') + '. '
        + 'Would you like to chat about it?';
    }

    function copyText(t, btn){
      var done = function(){
        var old = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(function(){ btn.textContent = old; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(t).then(done, function(){ prompt('Copy this message:', t); });
      } else {
        prompt('Copy this message:', t);
      }
    }

    function setMsg(t, err, success){
      var m = $('msg');
      m.textContent = t;
      m.className = 'show';
      if (err) m.classList.add('err');
      else if (success) m.classList.add('success');
      else m.classList.remove('err', 'success');
    }

    function updateWebsitePreview(value){
      var preview = $('urlPreview');
      var out = $('urlText');
      var safe = value.trim();

      if (!safe){
        preview.classList.remove('visible');
        return;
      }

      preview.classList.add('visible');
      var clean = safe.replace(/^https?:\/\//i, '').replace(/\/+$/, '');
      out.textContent = clean.length > 28 ? clean.slice(0, 28) + '…' : clean;
    }

    $('myurl').addEventListener('input', function(){
      updateWebsitePreview(this.value);
    });

    async function fetchAll(key, query){
      var hasHebrew = /[\u0590-\u05FF]/.test(query);
      var all = [], token = null;

      for (var page = 0; page < 3; page++){
        var body = { textQuery: query, pageSize: 20, regionCode: 'IL', languageCode: hasHebrew ? 'he' : 'en' };
        if (token) body.pageToken = token;

        var res = await fetch('https://places.googleapis.com/v1/places:searchText', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Goog-Api-Key': key,
            'X-Goog-FieldMask': 'places.id,places.displayName,places.formattedAddress,places.nationalPhoneNumber,places.websiteUri,places.googleMapsUri,places.rating,places.userRatingCount,nextPageToken'
          },
          body: JSON.stringify(body)
        });

        var data = await res.json();
        if (!res.ok) throw new Error((data.error && data.error.message) || 'Request failed');

        all = all.concat(data.places || []);
        token = data.nextPageToken;
        if (!token) break;
      }

      return all;
    }

    $('f').addEventListener('submit', async function(e){
      e.preventDefault();

      var key = $('key').value.trim();
      var query = $('type').value.trim() + ' in ' + $('city').value.trim();
      var myUrl = $('myurl').value.trim();
      var cityVal = $('city').value.trim();

      try {
        localStorage.setItem('placesKey', key);
        localStorage.setItem('myUrl', myUrl);
      } catch (err) {}

      var btn = $('go');
      var out = $('out');

      btn.disabled = true;
      out.textContent = '';
      $('leadCount').textContent = '0';
      $('checkedCount').textContent = '0';
      $('statusCount').textContent = 'Searching';
      setMsg('<span class=\"loader\"></span>Searching for leads…');

      try {
        var places = await fetchAll(key, query);
        var showSocial = $('social').checked;

        var leads = places.map(function(p){
          var w = p.websiteUri;
          p._status = !w ? 'none' : (SOCIAL.test(w) ? 'social' : 'site');
          return p;
        }).filter(function(p){
          return p._status === 'none' || (showSocial && p._status === 'social');
        });

        $('leadCount').textContent = leads.length;
        $('checkedCount').textContent = places.length;

        if (!places.length) {
          $('statusCount').textContent = 'No results';
          setMsg('No businesses found. Check the spelling of the type and city.', true);
        } else {
          $('statusCount').textContent = 'Ready';
          setMsg('Checked ' + places.length + ' businesses. Found ' + leads.length + ' potential leads.', false, true);
        }

        leads.forEach(function(p){
          var card = el('div', 'item');

          card.appendChild(el('h3', '', (p.displayName && p.displayName.text) || 'Unnamed business'));
          if (p.formattedAddress) card.appendChild(el('p', '', p.formattedAddress));

          var tag = el('span', 'tag' + (p._status === 'social' ? ' social' : ''),
            p._status === 'none' ? 'No website' : 'Social page only');

          card.appendChild(tag);

          if (p.rating) {
            var rating = el('div', 'rating');
            rating.appendChild(el('span', 'star', '★'));
            rating.appendChild(el('span', '', p.rating));
            rating.appendChild(document.createTextNode(' (' + (p.userRatingCount || 0) + ' reviews)'));
            card.appendChild(rating);
          }

          var acts = el('div', 'acts');

          if (p.nationalPhoneNumber) {
            acts.appendChild(link('Call', 'tel:' + p.nationalPhoneNumber.replace(/[^\d+]/g, '')));
          }
          if (p.websiteUri) acts.appendChild(link('See their page', p.websiteUri));
          if (p.googleMapsUri) acts.appendChild(link('Open in Maps', p.googleMapsUri));

          var nm = (p.displayName && p.displayName.text) || '';
          var q = function(site){
            return 'https://www.google.com/search?q=' + encodeURIComponent('site:' + site + ' ' + nm + ' ' + cityVal);
          };

          acts.appendChild(link('Find on Facebook', q('facebook.com')));
          acts.appendChild(link('Find on Instagram', q('instagram.com')));

          var cp = el('button', 'cp', 'Copy message');
          cp.type = 'button';
          cp.addEventListener('click', function(){
            copyText(pitch((p.displayName && p.displayName.text) || 'your business', myUrl), cp);
          });
          acts.appendChild(cp);

          card.appendChild(acts);
          out.appendChild(card);
        });
      } catch (err) {
        $('statusCount').textContent = 'Error';
        setMsg('Error: ' + err.message, true);
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
