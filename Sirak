    .site-wrap{position:relative;display:grid;gap:8px}
    .url-preview{
      display:flex;align-items:center;gap:8px;min-height:0;max-height:0;opacity:0;overflow:hidden;
      transform:translateY(-8px);transition:all .3s ease;padding:0 8px;color:var(--blue);font-size:13px;font-weight:700;
    }
    .url-preview.visible{
      max-height:32px;opacity:1;transform:translateY(0);padding-top:2px;
