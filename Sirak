      animation:pulse 1.6s infinite ease-in-out;
    }
    @keyframes pulse{
      0%,100%{transform:scale(1);opacity:1}
      50%{transform:scale(1.25);opacity:.8}
    }
    @keyframes slideIn{
      from{opacity:0;transform:translateY(-10px)}
      to{opacity:1;transform:translateY(0)}
    }

    #go{
      font:inherit;font-weight:800;background:linear-gradient(135deg, var(--blue), var(--blue-dark));color:#fff;border:0;border-radius:12px;padding:15px 18px;cursor:pointer;transition:all .25s ease;box-shadow:0 12px 24px rgba(47,91,255,.25);width:100%;position:relative;overflow:hidden;
    }
    #go:before{
      content:"";position:absolute;inset:-30%;
      background:linear-gradient(120deg, transparent 20%, rgba(255,255,255,.32), transparent 80%);
      transform:translateX(-120%) rotate(12deg);transition:transform .7s ease;
    }
    #go:hover:not(:disabled):before{transform:translateX(120%) rotate(12deg)}
    #go:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 16px 30px rgba(47,91,255,.32)}
    #go:active:not(:disabled){transform:translateY(0)}
    #go:disabled{opacity:.75;cursor:wait}

    #msg{
      margin:20px 0 12px;padding:12px 14px;border-radius:12px;color:var(--blue);
      background:rgba(47,91,255,.08);border:1px solid rgba(47,91,255,.12);
      font-weight:700;font-size:15px;transition:all .25s ease;opacity:0;transform:translateY(-8px);
    }
    #msg.show{opacity:1;transform:translateY(0)}
    #msg.err{
      color:var(--danger);background:rgba(217,87,87,.08);border-color:rgba(217,87,87,.15);
    }
    #msg.success{
      color:#0f7c5e;background:rgba(25,179,138,.08);border-color:rgba(25,179,138,.15);
    }
    .loader{
      display:inline-block;width:15px;height:15px;border:2px solid rgba(47,91,255,.2);border-top-color:var(--blue);border-radius:50%;animation:spin .8s linear infinite;vertical-align:middle;margin-right:8px;
    }
    @keyframes spin{to{transform:rotate(360deg)}}

    .summary{
      display:grid;grid-template-columns:repeat(3, minmax(0,1fr));gap:12px;margin:8px 0 18px;
    }
    .stat{
      background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow-soft);
    }
    .stat .label{
      font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;
    }
    .stat .value{
      font-size:24px;font-weight:800;letter-spacing:-.03em;
    }

    .list{display:grid;gap:16px;margin-top:4px}
    .item{
      background:var(--card);border:1px solid var(--line);border-radius:18px;
      box-shadow:var(--shadow-soft);padding:18px 18px 16px;
      opacity:0;transform:translateY(16px);animation:itemIn .45s ease forwards;
    }
    @keyframes itemIn{to{opacity:1;transform:translateY(0)}}
    .item h3{
      font-size:19px;font-weight:800;margin-bottom:4px;letter-spacing:-.02em;
    }
    .item p{color:var(--muted);font-size:15px;line-height:1.55}
