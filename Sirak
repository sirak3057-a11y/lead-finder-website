    form:focus-within{
      border-color:rgba(47,91,255,.42);
      box-shadow:0 18px 40px var(--glow);
      transform:translateY(-2px);
    }

    .two{display:grid;grid-template-columns:1fr 1fr;gap:14px}

    label{
      display:grid;gap:7px;font-size:14px;font-weight:700;color:var(--muted);
    }

    input[type=text], input[type=password]{
      width:100%;font:inherit;color:var(--ink);background:rgba(238,242,247,.9);
      border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;font-size:15px;
      transition:all .22s ease;
    }

    input:hover{border-color:#c6d3e6}
    input:focus-visible{
      outline:none;border-color:var(--blue);box-shadow:0 0 0 4px rgba(47,91,255,.12);background:#fff;
    }

    .chk{
      display:flex;align-items:center;gap:10px;color:var(--ink);font-size:14px;padding:10px 6px;border-radius:10px;transition:background .2s ease;cursor:pointer;
